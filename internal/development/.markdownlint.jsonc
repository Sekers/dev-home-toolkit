// markdownlint's rules for this repo's Markdown. VS Code's markdownlint extension reads this file
// through markdownlint.configFile in .vscode/settings.json (decision 0078 says why it's here).
{
  // Prose and headings wrap at 100 characters. Code blocks and tables can't wrap, so they have no
  // limit. A command in a skill stays on one line, because agents copy it and the tests match it
  // word for word, so those few lines pass 100.
  "MD013": {
    "line_length": 100,
    "heading_line_length": 100,
    "code_blocks": false,
    "tables": false
  }
}
