# Scratch space for text that leaves this repo, such as GitHub issue bodies
.drafts/

# Guidance for agents working here, which setup writes on each PC with that PC's commands
/AGENTS.md
/CLAUDE.md

# What a skill's scripts make on each PC: Python's caches of the scripts it imports, Python
# environments, and JavaScript packages. A skill that ships its packages can bring them back
# with "!node_modules/" in a .gitignore in its own folder.
__pycache__/
.venv/
node_modules/

# Files Windows creates: thumbnail caches, folder settings, and shortcuts
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
*.lnk

# Files macOS creates: folder settings, and resource forks on drives that aren't Mac-formatted
.DS_Store
._*

# Files Linux desktops and editors create: backups, folder settings, and trash folders
*~
.directory
.Trash-*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!*.code-workspace

# JetBrains IDEs: the items JetBrains says store user-specific settings, the only ones in .idea
# not to share
**/.idea/workspace.xml
**/.idea/usage.statistics.xml
**/.idea/shelf/
