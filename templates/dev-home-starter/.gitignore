# Scratch space for text that leaves this repo, such as GitHub issue bodies
.drafts/

# Files Windows creates: thumbnail caches, folder settings, and shortcuts
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
*.lnk

# Files macOS creates: folder settings, and resource forks on drives that aren't Mac-formatted
.DS_Store
._*

# Files Linux desktops and editors create: backups, folder settings, and trash folders
*~
.directory
.Trash-*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!*.code-workspace
